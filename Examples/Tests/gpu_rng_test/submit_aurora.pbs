#!/bin/bash -l
#PBS -A Catalyst
#PBS -N gpu_rng_test
#PBS -l select=1
#PBS -l walltime=00:10:00
#PBS -l filesystems=home
#PBS -l place=scatter
#PBS -q workq
#PBS -k doe

# Run the gpu_rng_test CTest executable on an Aurora GPU node.
# The binary must already be built via cmake --build before submitting this script.
# Build directory is assumed to be /home/zippy/src/warpx/build2 (adjust if needed).

set -euo pipefail

BUILD_DIR="/home/zippy/src/warpx/build_installShared"
EXE="${BUILD_DIR}/bin/gpu_rng_test"
LOG_DIR="/home/zippy/src/warpx/Examples/Tests/gpu_rng_test"

exec > "${LOG_DIR}/test_stdout.log" 2> "${LOG_DIR}/test_stderr.log"

echo "Jobid: ${PBS_JOBID:-}"
echo "Host: $(hostname)"
echo "EXE: ${EXE}"
echo ""

if [ ! -x "${EXE}" ]; then
    echo "ERROR: ${EXE} not found or not executable" >&2
    echo "Build first with: cmake --build ${BUILD_DIR} --target gpu_rng_test" >&2
    exit 1
fi

# --- Environment -----------------------------------------------------------
module reset
source $HOME/aurora_warpx.profile
export ZE_FLAT_DEVICE_HIERARCHY="COMPOSITE"

# --- Run: 1 rank -----------------------------------------------------------
echo "=== Run: 1 MPI rank, 1 GPU tile ==="
mpiexec --np 1 -ppn 1 \
    --cpu-bind=list:1-8 \
    --gpu-bind=list:0.0 \
    -genvall "${EXE}" amrex.verbose=0
echo ""

# --- Run: 12 ranks (one per GPU tile) ---------------------------------------
echo "=== Run: 12 MPI ranks, 12 GPU tiles ==="
mpiexec --np 12 -ppn 12 \
    --cpu-bind=list:1-8:9-16:17-24:25-32:33-40:41-48:53-60:61-68:69-76:77-84:85-92:93-100 \
    --gpu-bind=list:0.0:0.1:1.0:1.1:2.0:2.1:3.0:3.1:4.0:4.1:5.0:5.1 \
    -genvall "${EXE}" amrex.verbose=0
echo ""

echo "=== Done ==="
